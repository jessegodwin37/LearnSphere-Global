# ============================================================================
# LearnSphere Global — environment variables
# Copy to .env.local for local development. Never commit .env.local.
# ============================================================================

# ---- Supabase (required) ---------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose to the browser, never prefix with
# NEXT_PUBLIC_. Used by webhook handlers and the certificate route.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Site ------------------------------------------------------------------
# Used for OAuth redirects and canonical URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- AI (required for the AI tutor + outline generator) --------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ---- Stripe (optional) -----------------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Paystack (optional, for NGN/GHS/ZAR/KES) ------------------------------
# https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
